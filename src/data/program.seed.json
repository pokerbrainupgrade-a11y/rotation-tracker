      "ledger": {
        "velocityFull": true,
        "velocityPrime": true
      },
      "compression": {
        "75": {
          "cut": [
            "ex.vertical-jump"
          ],
          "note": "Secondary jump variant dropped; throws and primary jump intact."
        },
        "50": {
          "cut": [
            "ex.vertical-jump",
            "ex.back-squat"
          ],
          "note": "Speed-strength dropped. Power block only."
        },
        "25": {
          "keepOnly": [
            "ex.med-ball-throw"
          ],
          "note": "Max-intent throw block only. This is what makes it a TD1."
        }
      },
      "compressionRule": "TD1 compresses inward toward the max-intent throw block. That block is what the session is FOR \u2014 everything else is supporting work, and a TD1 without it does not count as a TD1.",
